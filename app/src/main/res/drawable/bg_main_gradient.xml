<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base vertical gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/background_light"
                android:centerColor="@color/primary_color"
                android:endColor="@color/card_background"
                android:angle="270" />
        </shape>
    </item>

    <!-- Soft radial glow at the top -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="500dp"
                android:centerX="50%"
                android:centerY="0%"
                android:startColor="#33FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>

    <!-- Subtle bottom vignette -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#00000000"
                android:endColor="#11000000"
                android:angle="90" />
        </shape>
    </item>
</layer-list>



